{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "notecal",
  "version": "1.0.1",
  "identifier": "com.troazz.notecal",
  "build": {
    "beforeDevCommand": {
      "script": "bun run dev",
      "cwd": "../ui"
    },
    "beforeBuildCommand": {
      "script": "bun run build",
      "cwd": "../ui"
    },
    "devUrl": "http://localhost:5173",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "notecal",
        "width": 720,
        "height": 520,
        "minWidth": 360,
        "minHeight": 240,
        "create": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "dmg",
      "appimage",
      "deb",
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "category": "Productivity",
    "macOS": {
      "signingIdentity": "-",
      "minimumSystemVersion": "11.0"
    },
    "linux": {
      "deb": {
        "section": "utils"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDFEQzYyMkNFRjJCODUzMTMKUldRVFU3anl6aUxHSFdOMmJ0R1ZFMDUvY1VIeHBQcXg3QTYxcCsvTTF6Y3ZTQnQzUXMrYURxbUIK",
      "endpoints": [
        "https://github.com/troazz/notecal/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
