{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "notecal",
  "version": "0.1.0",
  "identifier": "com.troazz.notecal",
  "build": {
    "beforeDevCommand": { "script": "bun run dev", "cwd": "../ui" },
    "beforeBuildCommand": { "script": "bun run build", "cwd": "../ui" },
    "devUrl": "http://localhost:5173",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "notecal",
        "width": 720,
        "height": 520,
        "minWidth": 360,
        "minHeight": 240
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "appimage"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.png"]
  }
}
